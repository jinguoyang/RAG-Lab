# 外部培训应用本地配置
# 复制为 .env 后修改

# PostgreSQL 数据库连接串
EXT_TRAINING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/external_training

# 平台 API 地址
EXT_TRAINING_PLATFORM_BASE_URL=http://localhost:8000/api/v1

# 平台 App ID（在平台注册后获取）
EXT_TRAINING_PLATFORM_APP_ID=

# 平台 API Key（在平台注册后获取）
EXT_TRAINING_PLATFORM_API_KEY=
